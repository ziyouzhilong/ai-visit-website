{
  "manifest_version": 3,
  "name": "AI Visit website",
  "version": "1.5.0",
  "description": "Connect AI Visit website agents to explicitly authorized pages in your visible Chrome session.",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Open AI Visit website bridge settings"
  },
  "options_page": "settings.html",
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png",
    "1024": "icons/icon1024.png"
  }
}
